# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/localroots

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Cloudinary (optional — leave blank to use local dev fallback for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
